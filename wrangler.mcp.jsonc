{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "budget-tracker-mcp",
  "main": "worker/mcp/index.ts",
  "compatibility_date": "2026-10-16",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "d8748edbef8b17443728cb5be64bdf19",
  "workers_dev": false,
  "preview_urls": false,
  "secrets": { "required": ["SUPABASE_PUBLISHABLE_KEY"] },
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "5fd5a889320b40198ce43e678a7eccab" }],
  "routes": [{ "pattern": "mcp.openbudgetracker.app", "custom_domain": true }],
  "vars": {
    "SUPABASE_URL": "https://dfuxxzlhmxscgvxdmwti.supabase.co",
    "MCP_RESOURCE": "https://mcp.openbudgetracker.app/mcp",
    "APP_ORIGIN": "https://openbudgetracker.app"
  },
  "ratelimits": [{ "name": "MCP_RATE_LIMITER", "namespace_id": "18431", "simple": { "limit": 60, "period": 60 } }],
  "observability": { "enabled": true, "head_sampling_rate": 1, "logs": { "invocation_logs": false } }
}
