{
  "name": "budget-tracker",
  "private": true,
  "version": "2.0.0-preview",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "vite",
    "demo": "vite --mode demo --host 127.0.0.1 --port 5173",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test:db": "vitest run tests/db --pool=forks --no-file-parallelism",
    "test:ui": "vitest run --config vitest.ui.config.ts",
    "test:e2e": "env -u NO_COLOR playwright test",
    "test:e2e:finish": "env -u NO_COLOR playwright test --config playwright.finish.config.ts",
    "test:e2e:bills": "env -u NO_COLOR playwright test --config playwright.bills.config.ts",
    "preview:up": "bash scripts/preview/up.sh",
    "preview:seed": "node scripts/preview/seed.ts",
    "check": "pnpm typecheck && pnpm test:db && pnpm test:ui && pnpm build",
    "check:cloudflare-env": "node scripts/cloudflare/check-build-environment.mjs",
    "build:cloudflare": "env -u DEBUG pnpm check:cloudflare-env && env -u DEBUG pnpm build",
    "deploy:cloudflare:frontend:dry-run": "pnpm exec wrangler deploy --config wrangler.frontend.jsonc --dry-run",
    "deploy:cloudflare:frontend": "pnpm build:cloudflare && pnpm deploy:cloudflare:frontend:dry-run && pnpm exec wrangler deploy --config wrangler.frontend.jsonc",
    "categorize": "node --env-file=.env.local benchmark/categorize.ts"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@playwright/test": "1.55.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.4.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@typesafe-ai/sdk": "^0.6.0",
    "@vitejs/plugin-react": "5.0.4",
    "jsdom": "30.0.1",
    "openai": "^7.19.0",
    "pg": "8.23.0",
    "testcontainers": "12.1.0",
    "typescript": "7.0.2",
    "vite": "7.1.7",
    "vitest": "5.0.0",
    "wrangler": "4.130.0",
    "zod": "^4.6.5"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0",
    "lucide-react": "1.45.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
