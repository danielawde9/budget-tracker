{
  "name": "budget-tracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "types:worker": "wrangler types",
    "check:worker-types": "wrangler types --check",
    "test:db": "vitest run tests/db --pool=forks --no-file-parallelism",
    "test:db:watch": "vitest tests/db --pool=forks --no-file-parallelism",
    "test:ui": "vitest run --config vitest.ui.config.ts",
    "test:ui:watch": "vitest --config vitest.ui.config.ts",
    "test:worker": "vitest run tests/worker",
    "test:e2e": "env -u NO_COLOR playwright test",
    "test:uat:offline": "env -u NO_COLOR playwright test e2e/private-uat.spec.ts",
    "check:uat:infra": "pnpm exec vitest run tests/ops/budget-uat-18.test.ts --pool=forks --no-file-parallelism",
    "typecheck": "pnpm check:worker-types && tsc --noEmit && tsc -p tsconfig.worker.json",
    "check:ops": "bash scripts/ops/check-budget.sh",
    "migrate:live": "bash scripts/ops/apply-live-migrations.sh",
    "check:cloudflare-env": "node scripts/cloudflare/check-build-environment.mjs",
    "build:cloudflare": "env -u DEBUG pnpm check:cloudflare-env && env -u DEBUG pnpm build",
    "deploy:cloudflare:frontend:dry-run": "pnpm exec wrangler deploy --config wrangler.frontend.jsonc --dry-run",
    "deploy:cloudflare:frontend": "pnpm build:cloudflare && pnpm deploy:cloudflare:frontend:dry-run && pnpm exec wrangler deploy --config wrangler.frontend.jsonc",
    "deploy:cloudflare:dry-run": "pnpm exec wrangler deploy --dry-run",
    "deploy:cloudflare": "pnpm build:cloudflare && pnpm deploy:cloudflare:dry-run && pnpm exec wrangler deploy",
    "check:ui": "pnpm typecheck && pnpm test:ui && pnpm build",
    "check:uat:scope": "bash scripts/check-private-uat-scope.sh",
    "check:uat:offline": "pnpm check:uat:scope && pnpm check:ops && pnpm typecheck && pnpm test:ui && pnpm build && pnpm test:e2e",
    "check": "pnpm check:ops && pnpm typecheck && pnpm test:db && pnpm test:worker && pnpm test:ui && pnpm build"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.4.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.4",
    "jsdom": "30.0.1",
    "pg": "8.23.0",
    "typescript": "7.0.2",
    "vite": "7.1.7",
    "vitest": "5.0.0",
    "wrangler": "4.130.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
